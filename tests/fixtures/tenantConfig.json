  "databases": [
    {
      "id": "con_1",
      "name": "Username-Password-Authentication",
      "strategy": "auth0",
      "is_domain_connection": true,
      "options": {
        "import_mode": false,
        "enabledDatabaseCustomization": true,
        "customScripts": {
          "login": "function login(identifierValue, password, callback) {\n  const secret = 'hunter2-secret';\n  const cfg = { host: 'db.internal.example.com', port: 5432 };\n  return callback(null, cfg);\n}\n",
          "create": "function create(user, callback) {\n  const x = 'a';\n  const tok = 'abcdef123456';\n  callback(null);\n}\n",
          "get_user": "function getUser(id, callback) { return callback(null); }"
        },
        "passwordPolicy": "fair",
        "password_history": {
          "size": 5,
          "enable": false
        },
        "password_no_personal_info": {
          "enable": false
        },
        "password_complexity_options": {
          "min_length": 8
        },
        "authentication_methods": {
          "password": {
            "enabled": true
          },
          "passkey": {
            "enabled": false
          }
        },
        "attributes": {
          "email": {
            "verification_method": "link"
          }
        }
      }
    },
